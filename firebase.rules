rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function admin(kode) {
      return request.auth != null && request.auth.token.email == kode + '@admin.undangan';
    }
    function publik(kode) {
      let p = /databases/$(db)/documents/undangan/$(kode)/pengaturan/utama;
      return !exists(p) || get(p).data.get('ucapanPublik', true) == true;
    }

    match /undangan/{kode} {

      match /ucapan/{id} {
        allow read: if admin(kode) || publik(kode);
        allow create: if request.resource.data.keys().hasOnly(['nama', 'pesan', 'hadir', 'waktu'])
                      && request.resource.data.nama is string
                      && request.resource.data.nama.size() > 0 && request.resource.data.nama.size() <= 40
                      && request.resource.data.pesan is string
                      && request.resource.data.pesan.size() > 0 && request.resource.data.pesan.size() <= 300
                      && request.resource.data.hadir in ['Hadir', 'Belum bisa hadir', 'Masih ragu']
                      && request.resource.data.waktu is timestamp
                      && request.resource.data.waktu > request.time - duration.value(10, 'm')
                      && request.resource.data.waktu < request.time + duration.value(10, 'm');
        allow delete: if admin(kode);
      }

      match /tamu/{id} {
        allow read, write: if admin(kode);
      }

      match /pengaturan/{id} {
        allow read: if true;
        allow write: if admin(kode);
      }
    }
  }
}
